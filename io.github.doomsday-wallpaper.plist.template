<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.doomsday-wallpaper</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BINARY_PATH__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/doomsday-wallpaper.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/doomsday-wallpaper.error.log</string>
</dict>
</plist>
